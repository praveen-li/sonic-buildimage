[Unit]
Description=Cisco 3232c Platform modules
After=local-fs.target
Before=pmon.service determine-reboot-cause.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cisco_platform.sh init
ExecStop=/usr/local/bin/cisco_platform.sh deinit
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
