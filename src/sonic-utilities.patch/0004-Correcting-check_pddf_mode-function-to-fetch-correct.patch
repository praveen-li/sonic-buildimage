From b871ba39e42e6ab1a234a01f8079b951bbea8349 Mon Sep 17 00:00:00 2001
From: abhiaga2 <abhiaga2@cisco.com>
Date: Thu, 15 Jul 2021 03:42:47 -0700
Subject: [PATCH] Correcting check_pddf_mode function to fetch correct
 platform_path

Signed-off-by: abhiaga2 <abhiaga2@cisco.com>
---
 utilities_common/util_base.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/utilities_common/util_base.py b/utilities_common/util_base.py
index 8dc15a4..cdd19b3 100644
--- a/utilities_common/util_base.py
+++ b/utilities_common/util_base.py
@@ -45,7 +45,9 @@ class UtilHelper(object):
         return platform_util
 
     def check_pddf_mode(self):
-        if os.path.exists(PDDF_FILE_PATH):
+        platform_path = device_info.get_path_to_platform_dir()
+        pddf_file_path = os.path.join(platform_path, "pddf_support")
+        if os.path.exists(pddf_file_path):
             return True
         else:
             return False
