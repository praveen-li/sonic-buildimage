{%- set PORT_ACTIVE = [] %}
{%- set PORT_TOR_SRV = [] %}
{%- set PORT_CSW_TOR = [] %}
{%- set PORT_FAB_CSW = [] %}

{%- for phy_port_idx in range(0, 24) %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (phy_port_idx*8)) %}{%- endif %}
{%- if PORT_TOR_SRV.append("Ethernet%d" % (phy_port_idx*8)) %}{%- endif %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (phy_port_idx*8+1)) %}{%- endif %}
{%- if PORT_TOR_SRV.append("Ethernet%d" % (phy_port_idx*8+1)) %}{%- endif %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (phy_port_idx*8+2)) %}{%- endif %}
{%- if PORT_TOR_SRV.append("Ethernet%d" % (phy_port_idx*8+2)) %}{%- endif %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (phy_port_idx*8+3)) %}{%- endif %}
{%- if PORT_TOR_SRV.append("Ethernet%d" % (phy_port_idx*8+3)) %}{%- endif %}
{%- endfor %}
{%- for port_idx in range(192, 256, 4) %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (port_idx)) %}{%- endif %}
{%- if PORT_CSW_TOR.append("Ethernet%d" % (port_idx)) %}{%- endif %}
{%- endfor %}

{%- macro generate_port_lists(PORT_ALL) %}
    {# Generate list of ports #}
    {%- for phy_port_idx in range(0, 24) %}
        {%- if PORT_ALL.append("Ethernet%d" % (phy_port_idx*8)) %}{%- endif %}
        {%- if PORT_ALL.append("Ethernet%d" % (phy_port_idx*8+1)) %}{%- endif %}
        {%- if PORT_ALL.append("Ethernet%d" % (phy_port_idx*8+2)) %}{%- endif %}
        {%- if PORT_ALL.append("Ethernet%d" % (phy_port_idx*8+3)) %}{%- endif %}
    {%- endfor %}
    {%- for port_idx in range(192, 256, 4) %}
        {%- if PORT_ALL.append("Ethernet%d" % (port_idx)) %}{%- endif %}
    {%- endfor %}
{%- endmacro %}