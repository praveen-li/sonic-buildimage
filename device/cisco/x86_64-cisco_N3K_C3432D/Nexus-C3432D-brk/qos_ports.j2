{%- set PORT_ACTIVE = [] %}
{%- set PORT_TOR_SRV = [] %}
{%- set PORT_CSW_TOR = [] %}
{%- set PORT_FAB_CSW = [] %}

{# include all ports, uplinks might not have RDMA/PFCs but still reserve for them #}
{%- for port_idx in range(0, 256, 2) %}
{%- if PORT_ACTIVE.append("Ethernet%d" % (port_idx)) %}{%- endif %}
{%- if PORT_FAB_CSW.append("Ethernet%d" % (port_idx)) %}{%- endif %}
{%- endfor %}

{%- macro generate_port_lists(PORT_ALL) %}
    {# Generate list of ports #}
    {%- for port_idx in range(0, 256, 2) %}
        {%- if PORT_ALL.append("Ethernet%d" % (port_idx)) %}{%- endif %}
    {%- endfor %}
{%- endmacro %}